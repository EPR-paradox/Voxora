# 真机调试时改成开发机的局域网地址，例如：
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1
# 不设置时按平台取默认值：Android 模拟器 10.0.2.2，其余 127.0.0.1。
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 非 loopback 客户端（真机 / 局域网）必须带 Bearer token，取值与后端 .env 的 API_ACCESS_TOKEN 一致。
# 这是本地开发的访问守卫，不是用户认证，不要用于公网部署（见设计 §12）。
EXPO_PUBLIC_API_ACCESS_TOKEN=
