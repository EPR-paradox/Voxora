APP_ENV=local
APP_NAME=voxora-api
DATABASE_URL=postgresql+asyncpg://voxora:voxora_dev_only@localhost:5432/voxora
LOCAL_USER_ID=10000000-0000-4000-8000-000000000001
API_ACCESS_TOKEN=
# mock | openai_compatible
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1000
# Evaluation is a separate provider with its own budget: one structured report costs far more
# completion tokens than one spoken turn (deepseek-flash spent ~1900, about half of it reasoning).
AI_EVALUATION_TIMEOUT_SECONDS=60
AI_EVALUATION_MAX_TOKENS=4000
AI_JSON_MODE=true
# JSON array. Only local Expo dev-server origins: the web preview is cross-origin, nothing else is.
CORS_ALLOW_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
MAX_USER_MESSAGE_CHARS=4000
MAX_CONTEXT_MESSAGES=24
LOG_LEVEL=INFO
# Speech transcription (§7.11, §8.6). ``mock`` keeps dev and tests offline; ``faster_whisper`` runs the
# model on this machine (GPU when the CUDA libs are present, CPU int8 otherwise).
SPEECH_PROVIDER=mock
SPEECH_MODEL=small.en
SPEECH_DEVICE=auto
SPEECH_COMPUTE_TYPE=int8
# Must NOT be AI_TIMEOUT_SECONDS: a 300 s clip takes minutes to decode on the CPU fallback path (§8.6).
SPEECH_TIMEOUT_SECONDS=180
SPEECH_MAX_SECONDS=300
SPEECH_MAX_BYTES=33554432
# Speech synthesis (§7.13). ``mock`` returns a real silent WAV so the phone stays playable offline;
# ``edge_tts`` is a keyless cloud voice service, verified reachable from this machine without a proxy.
# The audio is never stored, so there is no cache setting (meeting draft §9.2).
SPEECH_SYNTHESIS_PROVIDER=mock
SPEECH_SYNTHESIS_TIMEOUT_SECONDS=30
SPEECH_SYNTHESIS_MAX_CHARS=1000
